{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}
    <i class="fa fa-edit"></i> {{ 'mass_grade.enter_grades_title'|trans }}
{% endblock %}

{% block main %}
    <!-- Breadcrumb -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent mb-0 p-0">
                <li class="breadcrumb-item">
                    <a href="{{ path('admin_mass_grade_select_class') }}">
                        <i class="fa fa-users"></i> {{ 'entity.classes'|trans }}
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{ path('admin_mass_grade_select_evaluation', {classeId: classe.id}) }}">
                        {{ classe.description }}
                    </a>
                </li>
                <li class="breadcrumb-item active">{{ evaluation.description }}</li>
            </ol>
        </nav>
        <a href="{{ path('admin_mass_grade_select_evaluation', {classeId: classe.id}) }}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left"></i> {{ 'action.back'|trans }}
        </a>
    </div>

    <!-- Success Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show grade-entry-alert" role="alert">
            <i class="fa fa-check-circle"></i> {{ message }}
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    {% endfor %}

    <!-- Evaluation Info Banner -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="info-card class-info-card">
                <div class="info-card-icon">
                    <i class="fa fa-school"></i>
                </div>
                <div class="info-card-content">
                    <h5>{{ classe.description }}</h5>
                    <div class="info-card-meta">
                        <span><i class="fa fa-calendar"></i> {{ classe.annee }}</span>
                        <span><i class="fa fa-user-graduate"></i> {{ etudiants.count }} {{ 'entity.students'|trans|lower }}</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="info-card evaluation-info-card">
                <div class="info-card-icon">
                    <i class="fa fa-clipboard-check"></i>
                </div>
                <div class="info-card-content">
                    <h5>{{ evaluation.description }}</h5>
                    <div class="info-card-meta">
                        <span><i class="fa fa-calendar"></i> {{ evaluation.date|date('d/m/Y H:i') }}</span>
                        <span><i class="fa fa-calculator"></i> {{ 'form.coefficient'|trans }}: {{ evaluation.coef }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-primary">
                    <i class="fa fa-users"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-value">{{ etudiants.count }}</div>
                    <div class="stat-label">{{ 'entity.students'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-success">
                    <i class="fa fa-check-circle"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-value" id="graded-count">{{ existingNotes|length }}</div>
                    <div class="stat-label">{{ 'mass_grade.graded'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-warning">
                    <i class="fa fa-clock"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-value" id="pending-count">{{ etudiants.count - existingNotes|length }}</div>
                    <div class="stat-label">{{ 'mass_grade.pending'|trans }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon bg-info">
                    <i class="fa fa-percent"></i>
                </div>
                <div class="stat-content">
                    <div class="stat-value" id="completion-rate">{{ etudiants.count > 0 ? ((existingNotes|length / etudiants.count) * 100)|round : 0 }}%</div>
                    <div class="stat-label">{{ 'mass_grade.completion'|trans }}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grade Entry Form -->
    <form method="post" id="massGradeForm">
        <div class="card grade-entry-card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fa fa-edit"></i> {{ 'mass_grade.enter_grades_title'|trans }}
                    </h5>
                    <div class="progress-badge">
                        <span id="progress-text">{{ existingNotes|length }}/{{ etudiants.count }}</span>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mass-grade-table">
                        <thead>
                            <tr>
                                <th style="width: 5%">#</th>
                                <th style="width: 25%">{{ 'form.name'|trans }}</th>
                                <th style="width: 25%">{{ 'form.first_name'|trans }}</th>
                                <th style="width: 15%">{{ 'form.gender'|trans }}</th>
                                <th style="width: 20%">{{ 'mass_grade.grade_column'|trans }}</th>
                                <th style="width: 10%" class="text-center">{{ 'mass_grade.status'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for etudiant in etudiants %}
                                {% set existingNote = existingNotes[etudiant.id] ?? null %}
                                <tr class="grade-row {% if existingNote %}has-grade{% endif %}" data-student-id="{{ etudiant.id }}">
                                    <td class="student-number">{{ loop.index }}</td>
                                    <td class="student-name">
                                        <strong>{{ etudiant.nom }}</strong>
                                    </td>
                                    <td class="student-firstname">{{ etudiant.prenom }}</td>
                                    <td>
                                        {% if etudiant.genre == 'M' %}
                                            <span class="badge badge-primary badge-gender">
                                                <i class="fa fa-male"></i> {{ 'form.male'|trans }}
                                            </span>
                                        {% else %}
                                            <span class="badge badge-danger badge-gender">
                                                <i class="fa fa-female"></i> {{ 'form.female'|trans }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="grade-input-wrapper">
                                            <input type="number"
                                                   step="0.01"
                                                   min="0"
                                                   max="20"
                                                   name="grades[{{ etudiant.id }}]"
                                                   value="{{ existingNote ? existingNote.valeur : '' }}"
                                                   class="form-control grade-input"
                                                   placeholder="--"
                                                   autocomplete="off"
                                                   data-student-id="{{ etudiant.id }}">
                                            <span class="grade-suffix">/20</span>
                                        </div>
                                    </td>
                                    <td class="text-center status-cell">
                                        {% if existingNote %}
                                            <i class="fa fa-check-circle text-success status-icon" title="{{ 'mass_grade.saved'|trans }}"></i>
                                        {% else %}
                                            <i class="fa fa-circle text-muted status-icon" title="{{ 'mass_grade.not_saved'|trans }}"></i>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer grade-entry-footer">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-warning" onclick="clearAllGrades()">
                            <i class="fa fa-eraser"></i> {{ 'mass_grade.clear_all'|trans }}
                        </button>
                    </div>
                    <div class="col-md-4 text-center">
                        <small class="text-muted keyboard-hint">
                            <i class="fa fa-keyboard"></i> {{ 'mass_grade.keyboard_hint'|trans }}
                        </small>
                    </div>
                    <div class="col-md-4 text-right">
                        <button type="submit" class="btn btn-success btn-lg save-grades-btn">
                            <i class="fa fa-save"></i> {{ 'action.save'|trans }}
                            <span class="btn-badge" id="changes-badge" style="display: none;">0</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Help Card -->
    <div class="help-card mt-4">
        <div class="help-card-header">
            <i class="fa fa-lightbulb"></i> {{ 'mass_grade.help_title'|trans }}
        </div>
        <div class="help-card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="help-item">
                        <i class="fa fa-keyboard text-primary"></i>
                        <p>{{ 'mass_grade.help_1'|trans }}</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="help-item">
                        <i class="fa fa-sort-numeric-up text-success"></i>
                        <p>{{ 'mass_grade.help_2'|trans }}</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="help-item">
                        <i class="fa fa-save text-info"></i>
                        <p>{{ 'mass_grade.help_3'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let changesCount = 0;
        const initialValues = new Map();

        // Store initial values
        document.querySelectorAll('.grade-input').forEach(input => {
            initialValues.set(input.dataset.studentId, input.value);
        });

        function clearAllGrades() {
            if (confirm('{{ 'mass_grade.confirm_clear'|trans }}')) {
                document.querySelectorAll('.grade-input').forEach(input => {
                    input.value = '';
                    updateRowStatus(input);
                });
                updateStatistics();
            }
        }

        function updateRowStatus(input) {
            const row = input.closest('tr');
            const statusIcon = row.querySelector('.status-icon');
            const hasValue = input.value !== '';

            if (hasValue) {
                row.classList.add('has-grade');
                statusIcon.className = 'fa fa-check-circle text-success status-icon';
                statusIcon.title = '{{ 'mass_grade.saved'|trans }}';
            } else {
                row.classList.remove('has-grade');
                statusIcon.className = 'fa fa-circle text-muted status-icon';
                statusIcon.title = '{{ 'mass_grade.not_saved'|trans }}';
            }
        }

        function updateStatistics() {
            const inputs = document.querySelectorAll('.grade-input');
            const gradedCount = Array.from(inputs).filter(input => input.value !== '').length;
            const totalCount = inputs.length;
            const pendingCount = totalCount - gradedCount;
            const completionRate = totalCount > 0 ? Math.round((gradedCount / totalCount) * 100) : 0;

            document.getElementById('graded-count').textContent = gradedCount;
            document.getElementById('pending-count').textContent = pendingCount;
            document.getElementById('completion-rate').textContent = completionRate + '%';
            document.getElementById('progress-text').textContent = `${gradedCount}/${totalCount}`;

            // Update changes badge
            changesCount = Array.from(inputs).filter(input => {
                const initial = initialValues.get(input.dataset.studentId);
                return input.value !== initial;
            }).length;

            const badge = document.getElementById('changes-badge');
            if (changesCount > 0) {
                badge.style.display = 'inline-block';
                badge.textContent = changesCount;
            } else {
                badge.style.display = 'none';
            }
        }

        // Auto-focus on first empty input
        document.addEventListener('DOMContentLoaded', function() {
            const firstEmptyInput = Array.from(document.querySelectorAll('.grade-input'))
                .find(input => input.value === '');
            if (firstEmptyInput) {
                firstEmptyInput.focus();
                firstEmptyInput.select();
            }
        });

        // Keyboard navigation (Enter to move to next input)
        document.querySelectorAll('.grade-input').forEach((input, index, inputs) => {
            // Real-time update on input
            input.addEventListener('input', function() {
                updateRowStatus(this);
                updateStatistics();
            });

            // Keyboard navigation
            input.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    const nextInput = inputs[index + 1];
                    if (nextInput) {
                        nextInput.focus();
                        nextInput.select();
                    } else {
                        document.getElementById('massGradeForm').submit();
                    }
                } else if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    const nextInput = inputs[index + 1];
                    if (nextInput) {
                        nextInput.focus();
                        nextInput.select();
                    }
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    const prevInput = inputs[index - 1];
                    if (prevInput) {
                        prevInput.focus();
                        prevInput.select();
                    }
                }
            });
        });

        // Prevent accidental navigation away
        let formSubmitted = false;
        document.getElementById('massGradeForm').addEventListener('submit', function() {
            formSubmitted = true;
        });

        window.addEventListener('beforeunload', function(e) {
            if (changesCount > 0 && !formSubmitted) {
                e.preventDefault();
                e.returnValue = '';
            }
        });
    </script>
{% endblock %}
