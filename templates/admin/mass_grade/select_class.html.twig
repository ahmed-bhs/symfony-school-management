<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'mass_grade.select_class_title'|trans }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/class-selection.css') }}">
    <link rel="stylesheet" href="{{ asset('css/mass-grade-entry.css') }}">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <a class="navbar-brand" href="{{ path('admin') }}">
            <i class="fa fa-arrow-left"></i> {{ 'action.back'|trans }}
        </a>
        <span class="navbar-text text-white">
            {{ 'app.name'|trans }}
        </span>
    </nav>

    <div class="container-fluid mt-4">
        <h1 class="mb-4">
            <i class="fa fa-edit"></i> {{ 'mass_grade.select_class_title'|trans }}
        </h1>
    <div class="class-selection-container">
        <div class="selection-header">
            <h2>{{ 'mass_grade.select_class_description'|trans }}</h2>
            <p class="text-muted">{{ 'mass_grade.select_class_help'|trans }}</p>
        </div>

        <div class="class-cards-grid">
            {% for classe in classes %}
                {% set colorIndex = classe.id % 8 %}
                <a href="{{ path('admin_mass_grade_select_evaluation', {classeId: classe.id}) }}"
                   class="class-card class-card-color-{{ colorIndex }}">
                    <div class="class-card-header">
                        <div class="class-icon">
                            <i class="fa fa-users"></i>
                        </div>
                        <div class="class-badge">
                            <span class="badge badge-primary">{{ classe.etudiants.count }}</span>
                        </div>
                    </div>

                    <div class="class-card-body">
                        <h3 class="class-title">{{ classe.description }}</h3>
                        <p class="class-year">
                            <i class="fa fa-calendar"></i> {{ 'form.year'|trans }}: {{ classe.annee }}
                        </p>
                        <p class="class-count">
                            {{ classe.etudiants.count }} {{ 'entity.students'|trans|lower }}
                        </p>
                    </div>

                    <div class="class-card-footer">
                        <span class="view-link">
                            {{ 'mass_grade.select'|trans }} <i class="fa fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            {% else %}
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> {{ 'class_selection.no_classes'|trans }}
                </div>
            {% endfor %}
        </div>
    </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
