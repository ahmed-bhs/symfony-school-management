<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ app.request.locale == 'ar' ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'mass_grade.select_evaluation_title'|trans }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('css/mass-grade-entry.css') }}">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <a class="navbar-brand" href="{{ path('admin') }}">
            <i class="fa fa-home"></i> {{ 'menu.dashboard'|trans }}
        </a>
        <span class="navbar-text text-white">
            {{ 'app.name'|trans }}
        </span>
    </nav>

    <div class="container-fluid mt-4">
        <h1 class="mb-4">
            <i class="fa fa-clipboard-check"></i> {{ 'mass_grade.select_evaluation_title'|trans }}
        </h1>
    <div class="container-fluid">
        <div class="mb-4">
            <a href="{{ path('admin_mass_grade_select_class') }}" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> {{ 'action.back'|trans }}
            </a>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <h3><i class="fa fa-school"></i> {{ classe.description }} - {{ classe.annee }}</h3>
                <p class="mb-0">{{ classe.etudiants.count }} {{ 'entity.students'|trans|lower }}</p>
            </div>

            <div class="card-body">
                <h4 class="mb-3">{{ 'mass_grade.select_evaluation_description'|trans }}</h4>

                {% if evaluations is empty %}
                    <div class="alert alert-warning">
                        <i class="fa fa-exclamation-triangle"></i> {{ 'mass_grade.no_evaluations'|trans }}
                    </div>
                {% else %}
                    <div class="list-group">
                        {% for evaluation in evaluations %}
                            <a href="{{ path('admin_mass_grade_enter', {evaluationId: evaluation.id}) }}"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-1">
                                        <i class="fa fa-clipboard-check text-primary"></i>
                                        {{ evaluation.description }}
                                    </h5>
                                    <small class="text-muted">
                                        <i class="fa fa-calendar"></i> {{ evaluation.date|date('d/m/Y H:i') }}
                                        | <i class="fa fa-book"></i> {{ 'form.semester'|trans }}: {{ evaluation.semestre }}
                                        | <i class="fa fa-percent"></i> {{ 'form.coefficient'|trans }}: {{ evaluation.coef }}
                                    </small>
                                </div>
                                <span class="badge badge-primary badge-pill">
                                    <i class="fa fa-arrow-right"></i>
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
