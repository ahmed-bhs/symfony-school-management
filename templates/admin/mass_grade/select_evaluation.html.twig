{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}
    <i class="fa fa-clipboard-check"></i> {{ 'mass_grade.select_evaluation_title'|trans }}
{% endblock %}

{% block main %}
    <!-- Breadcrumb and Back Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent mb-0 p-0">
                <li class="breadcrumb-item">
                    <a href="{{ path('admin_mass_grade_select_class') }}">
                        <i class="fa fa-users"></i> {{ 'entity.classes'|trans }}
                    </a>
                </li>
                <li class="breadcrumb-item active">{{ classe.description }}</li>
            </ol>
        </nav>
        <a href="{{ path('admin_mass_grade_select_class') }}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left"></i> {{ 'action.back'|trans }}
        </a>
    </div>

    <!-- Class Info Banner -->
    <div class="evaluation-class-banner mb-4">
        <div class="class-banner-content">
            <div class="class-banner-icon">
                <i class="fa fa-school"></i>
            </div>
            <div class="class-banner-info">
                <h3 class="mb-1">{{ classe.description }}</h3>
                <div class="class-banner-meta">
                    <span class="badge badge-light">
                        <i class="fa fa-calendar"></i> {{ classe.annee }}
                    </span>
                    <span class="badge badge-light">
                        <i class="fa fa-user-graduate"></i> {{ classe.etudiants.count }} {{ 'entity.students'|trans|lower }}
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Section Title -->
    <div class="section-header mb-4">
        <h4 class="section-title">
            <i class="fa fa-clipboard-list"></i> {{ 'mass_grade.select_evaluation_description'|trans }}
        </h4>
        <p class="section-subtitle text-muted">
            {{ 'mass_grade.select_evaluation_help'|trans }}
        </p>
    </div>

    <!-- Evaluations List -->
    {% if evaluations is empty %}
        <div class="empty-state-card">
            <div class="empty-state-icon">
                <i class="fa fa-clipboard"></i>
            </div>
            <h5 class="empty-state-title">{{ 'mass_grade.no_evaluations'|trans }}</h5>
            <p class="empty-state-text">{{ 'mass_grade.no_evaluations_help'|trans }}</p>
        </div>
    {% else %}
        <div class="evaluations-grid">
            {% for evaluation in evaluations %}
                <a href="{{ path('admin_mass_grade_enter', {evaluationId: evaluation.id}) }}"
                   class="evaluation-card">
                    <div class="evaluation-card-header">
                        <div class="evaluation-icon">
                            <i class="fa fa-clipboard-check"></i>
                        </div>
                        <div class="evaluation-semester">
                            <span class="semester-badge">S{{ evaluation.semestre }}</span>
                        </div>
                    </div>

                    <div class="evaluation-card-body">
                        <h5 class="evaluation-title">{{ evaluation.description }}</h5>

                        <div class="evaluation-meta">
                            <div class="meta-item">
                                <i class="fa fa-calendar text-primary"></i>
                                <span>{{ evaluation.date|date('d/m/Y') }}</span>
                            </div>
                            <div class="meta-item">
                                <i class="fa fa-clock text-info"></i>
                                <span>{{ evaluation.date|date('H:i') }}</span>
                            </div>
                            <div class="meta-item">
                                <i class="fa fa-calculator text-success"></i>
                                <span>{{ 'form.coefficient'|trans }}: {{ evaluation.coef }}</span>
                            </div>
                        </div>
                    </div>

                    <div class="evaluation-card-footer">
                        <span class="btn-link-text">
                            {{ 'mass_grade.enter_grades'|trans }}
                            <i class="fa fa-arrow-right ml-2"></i>
                        </span>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
