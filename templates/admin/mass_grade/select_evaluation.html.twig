{% extends '@EasyAdmin/layout.html.twig' %}

{% block content_title %}
    <i class="fa fa-clipboard-check"></i> {{ 'mass_grade.select_evaluation_title'|trans }}
{% endblock %}

{% block main %}
    <div class="mb-4">
        <a href="{{ ea_url().setRoute('admin_mass_grade_select_class') }}" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> {{ 'action.back'|trans }}
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h3><i class="fa fa-school"></i> {{ classe.description }} - {{ classe.annee }}</h3>
            <p class="mb-0">{{ classe.etudiants.count }} {{ 'entity.students'|trans|lower }}</p>
        </div>

        <div class="card-body">
            <h4 class="mb-3">{{ 'mass_grade.select_evaluation_description'|trans }}</h4>

            {% if evaluations is empty %}
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle"></i> {{ 'mass_grade.no_evaluations'|trans }}
                </div>
            {% else %}
                <div class="list-group">
                    {% for evaluation in evaluations %}
                        <a href="{{ path('admin_mass_grade_enter', {evaluationId: evaluation.id}) }}"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">
                                    <i class="fa fa-clipboard-check text-primary"></i>
                                    {{ evaluation.description }}
                                </h5>
                                <small class="text-muted">
                                    <i class="fa fa-calendar"></i> {{ evaluation.date|date('d/m/Y H:i') }}
                                    | <i class="fa fa-book"></i> {{ 'form.semester'|trans }}: {{ evaluation.semestre }}
                                    | <i class="fa fa-percent"></i> {{ 'form.coefficient'|trans }}: {{ evaluation.coef }}
                                </small>
                            </div>
                            <span class="badge badge-primary badge-pill">
                                <i class="fa fa-arrow-right"></i>
                            </span>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
